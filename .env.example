# ====================================================================
# HAVEN AGENT ENGINE - ZERO-COST INFRASTRUCTURE ENVIRONMENT SETUP
# All services below have permanent free tiers requiring $0 / no credit card.
# ====================================================================

# 1. Z.ai (Zhipu AI) - Permanent Free Flash Tier
# Register free at: https://open.bigmodel.cn/
# Model: glm-4.7-flash (Unlimited monthly tokens, high concurrency)
ZAI_API_KEY=your_free_zhipu_api_key_here

# 2. Groq Cloud - Ultra High-Speed Free Tier
# Register free at: https://console.groq.com/
# Models rotated: llama-3.3-70b-versatile, llama-3.1-8b-instant, qwen-2.5-32b
GROQ_API_KEY=your_free_groq_api_key_here

# 3. Mistral AI - La Plateforme Free Experiment Tier
# Register free at: https://console.mistral.ai/
# Model: mistral-small-latest
MISTRAL_API_KEY=your_free_mistral_api_key_here

# 4. Supabase (PostgreSQL Database & Storage)
# Free project at: https://supabase.com/ (500MB free database)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# 5. WhatsApp & Slack Webhook Instant Alerting ($0 Free Tier)
# Free WhatsApp via CallMeBot API or Twilio Free Sandbox:
WHATSAPP_WEBHOOK_URL=https://api.callmebot.com/whatsapp.php?phone=...&apikey=...
# Free Slack Incoming Webhook:
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# 6. Google Business Profile API OAuth Token (Optional for direct publishing)
GBP_ACCESS_TOKEN=

# 7. Server Port
PORT=3000
